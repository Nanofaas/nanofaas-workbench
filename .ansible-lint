---
exclude_paths:
  - .superpowers/
  - playbooks/run.yml  # imported with wb_action / wb_hosts, not standalone
  - .venv/
  - .ansible/
  - .github/
  - .pre-commit-config.yaml
  - uv.lock
skip_list:
  # ansible-lint's list of supported versions lags ansible-core 2.20.
  - meta-runtime[unsupported-version]
